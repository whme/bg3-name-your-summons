# Build output (.pak + .zip) and the downloaded LSLib toolchain.
build/
.tools/

# Local, uncommitted per-project agent settings (Claude Code writes these).
.claude/settings.local.json

# Self-bootstrapped dev tooling downloaded by make.ps1 (StyLua, luacheck,
# lua-language-server, the Lua interpreter, LuaUnit).
.tools/

# Drop-zone for the BG3SE IDE helpers (ExtIdeHelpers.lua) that lua-language-server
# reads for full Ext/Osi autocomplete. Not committed - fetched per developer.
.luals-libs/

# lua-language-server --check output.
luals-log/

# Compiled localization binaries. The .loca.xml sources are committed; the binary
# .loca the game loads is produced only in the temp build stage (make.ps1 build).
*.loca
