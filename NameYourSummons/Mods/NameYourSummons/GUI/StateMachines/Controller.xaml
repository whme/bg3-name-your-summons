<ls:StateMachine xmlns:ls="clr-namespace:ls;assembly=Code"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ls:StateMachine.States>

        <!-- Override ONLY the Examine state so the controller layout loads our
             Examine_c.xaml (a bare filename resolves to this mod's own Pages). The base
             controller Examine STATE is named "Examine" (not "Examine_c"; that is only
             the widget filename).

             We deliberately do NOT copy the base state's IE.UICancel -> RemoveState: a
             state-level cancel closes the whole panel unconditionally, so the settings
             overlay could not make Circle close only itself. Closing Examine on Circle is
             instead driven by the widget's footer UICancel button (CustomEvent ->
             CloseWidget, gated off while the overlay is open). -->
        <ls:State Name="Examine" ModType="Override" DisableStatesBelow="True" HideStatesBelow="False" IsModal="True" Layout="Player" Owner="Player">
            <ls:State.Widgets>
                <ls:StateWidget Filename="Examine_c.xaml" Layer="PopupPanels"/>
            </ls:State.Widgets>
            <ls:State.Events>
                <ls:StateEvent Name="IE.ToggleInGameMenu">
                    <ls:StateEvent.Actions>
                        <ls:PushState Name="Paused"/>
                        <ls:RemoveState/>
                    </ls:StateEvent.Actions>
                </ls:StateEvent>
                <ls:StateEvent Name="CloseWidget">
                    <ls:StateEvent.Actions>
                        <ls:RemoveState/>
                    </ls:StateEvent.Actions>
                </ls:StateEvent>
                <ls:StateEvent Name="OpenPinnedTooltips">
                    <ls:StateEvent.Actions>
                        <ls:AddSubstate Name="PinnedTooltips"/>
                    </ls:StateEvent.Actions>
                </ls:StateEvent>
                <ls:StateEvent Name="OpenMessageBox">
                    <ls:StateEvent.Actions>
                        <ls:AddSubstate Name="MessageBox"/>
                    </ls:StateEvent.Actions>
                </ls:StateEvent>
            </ls:State.Events>
        </ls:State>

        <!-- Manual-Examine detection needs a persistent HUD overlay. A StateWidget added to
             PlayerHUD via Extend appears for a single player but does NOT replicate into the
             per-player PlayerHUD instances split-screen creates. Mount it as its OWN
             Owner="Player" state pulled in as an InitialSubstate instead - the pattern the
             game itself uses for the per-player PlayerPortraits - so it exists for every
             viewport. Extend merges additively, so PlayerHUD's own PlayerPortraits substate
             is preserved. -->
        <ls:State Name="PlayerHUD" ModType="Extend" Layout="Adaptive" Owner="Player">
            <ls:State.InitialSubstates>
                <ls:InitialSubstate Name="NYS_HudOverlayState"/>
            </ls:State.InitialSubstates>
        </ls:State>

        <!-- Layout="Player" (not the parent's "Adaptive") so each split-screen viewport gets
             its own instance, exactly like the game's per-player PlayerPortraits substate. -->
        <ls:State Name="NYS_HudOverlayState" Layout="Player" Owner="Player">
            <ls:State.Widgets>
                <ls:StateWidget Filename="NysHudOverlay.xaml" Layer="HUD" IgnoreHitTest="True"/>
            </ls:State.Widgets>
        </ls:State>

    </ls:StateMachine.States>
</ls:StateMachine>
